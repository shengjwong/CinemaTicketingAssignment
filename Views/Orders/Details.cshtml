@model OrderDetailViewModel
@{ ViewData["Title"] = "Order Details"; }
<div class="container my-4"><a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-3">← Back to orders</a><div class="content-card p-4"><div class="d-flex justify-content-between border-bottom pb-3 mb-3"><div><h3 class="m-0">Order #@Model.Order.Id</h3><small class="text-muted">@Model.Order.Type order · @Model.Order.OrderedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</small></div><span class="badge align-self-start @(Model.Order.CanCancel ? "bg-success" : "bg-secondary")">@Model.Order.Status</span></div><dl class="row"><dt class="col-sm-3">Customer</dt><dd class="col-sm-9">@Model.Order.CustomerName (@Model.Order.CustomerEmail)</dd><dt class="col-sm-3">Amount</dt><dd class="col-sm-9">RM @Model.Order.TotalAmount.ToString("0.00")</dd>@if (Model.MovieTitle is not null) { <dt class="col-sm-3">Movie</dt><dd class="col-sm-9">@Model.MovieTitle</dd><dt class="col-sm-3">Showtime</dt><dd class="col-sm-9">@Model.Showtime?.ToString("dd MMM yyyy, HH:mm") · @Model.HallName</dd><dt class="col-sm-3">Seats</dt><dd class="col-sm-9">@Model.Seats</dd> }</dl>@if (Model.Items.Any()) { <h5>Items</h5><ul class="list-group">@foreach (var item in Model.Items) { <li class="list-group-item d-flex justify-content-between">@item.Name × @item.Quantity <span>RM @(item.UnitPrice * item.Quantity).ToString("0.00")</span></li> }</ul> }</div></div>
