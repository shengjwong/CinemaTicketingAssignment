@model List<CinemaHall>
@{
    ViewData["Title"] = "Manage Cinema Halls";
}

<div class="container my-4">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center mb-3 gap-2">
        <h2 class="page-title m-0">Manage Cinema Halls</h2>
        <a asp-action="Create" class="btn btn-primary fw-bold shadow-sm">
            <i class="bi bi-plus-circle me-1"></i>Add Cinema Hall
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm mb-3">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm mb-3">@TempData["Error"]</div>
    }

    @if (!Model.Any())
    {
        <div class="content-card text-center py-5">
            <i class="bi bi-door-closed text-muted display-4"></i>
            <p class="text-muted mt-3 mb-0">No cinema halls configured yet.</p>
        </div>
    }
    else
    {
        <div class="table-card p-0 overflow-hidden">
            <div class="table-responsive">
                <table class="table custom-table mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>Hall Name</th>
                            <th>Type</th>
                            <th>Seat Capacity</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var hall in Model)
                        {
                            <tr>
                                <td>
                                    <span class="fw-bold text-dark">@hall.HallName</span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border px-2 py-1">@hall.HallType</span>
                                </td>
                                <td>
                                    <span class="fw-semibold text-secondary">
                                        <i class="bi bi-grid-3x3-gap me-1"></i>@hall.SeatCapacity Seats
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Details" asp-route-id="@hall.Id" class="btn btn-outline-primary fw-semibold">View</a>
                                        <a asp-action="Edit" asp-route-id="@hall.Id" class="btn btn-outline-secondary fw-semibold">Edit</a>
                                        <a asp-action="Delete" asp-route-id="@hall.Id" class="btn btn-outline-danger fw-semibold">Delete</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>