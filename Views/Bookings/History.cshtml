@model List<CinemaTicketingAssignment.Models.Booking>
@{
    ViewData["Title"] = "My Bookings";
}

<div class="container my-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="page-title m-0">My Bookings</h2>
    </div>

    @if (!Model.Any())
    {
        <div class="content-card text-center py-5">
            <i class="bi bi-ticket-perforated text-muted display-4"></i>
            <p class="text-muted mt-3 mb-0">You have not made any ticket bookings yet.</p>
        </div>
    }
    else
    {
        <div class="table-card p-0 overflow-hidden">
            <div class="table-responsive">
                <table class="table custom-table mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>Booking ID</th>
                            <th>Movie & Showtime</th>
                            <th>Seats</th>
                            <th>Total Amount</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var booking in Model)
                        {
                            <tr>
                                <td>
                                    <span class="fw-bold text-dark">#@booking.Id</span>
                                    <br />
                                    <small class="text-muted">@booking.BookingDate.ToLocalTime().ToString("dd MMM yyyy")</small>
                                </td>
                                <td>
                                    <span class="fw-bold text-primary">@booking.Showtime.Movie.Title</span>
                                    <br />
                                    <small class="text-secondary">
                                        <i class="bi bi-calendar-event me-1"></i>@booking.Showtime.StartDateTime.ToString("dd MMM yyyy, h:mm tt")
                                    </small>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border px-2 py-1">
                                        @booking.SelectedSeats
                                    </span>
                                </td>
                                <td>
                                    <span class="fw-bold text-dark">RM @booking.TotalAmount.ToString("0.00")</span>
                                    <br />
                                    <span class="badge status-badge-active">@booking.PaymentStatus</span>
                                </td>
                                <td class="text-end">
                                    <a asp-action="Receipt" asp-route-id="@booking.Id" class="btn btn-outline-primary btn-sm px-3 fw-semibold">
                                        Receipt
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>