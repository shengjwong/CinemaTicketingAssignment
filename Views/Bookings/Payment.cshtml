@model CinemaTicketingAssignment.Models.Showtime
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Secure Payment";
    var seats = (List<string>)ViewBag.Seats;
    var total = Model.TicketPrice * seats.Count;
    var payPalClientId = Configuration["PayPal:ClientId"] ?? string.Empty;
    var payPalConfigured = !string.IsNullOrWhiteSpace(payPalClientId) && !payPalClientId.StartsWith("REPLACE_", StringComparison.OrdinalIgnoreCase);
}

<div class="row justify-content-center my-4">
    <div class="col-lg-7">
        <div class="form-card">
            <div class="text-center mb-4">
                <h2 class="page-title m-0">Secure Payment</h2>
                <p class="text-muted small mt-1">Choose a sandbox payment method. No real payment will be charged.</p>
            </div>

            @if (TempData["Error"] is string error)
            {
                <div class="alert alert-danger border-0 shadow-sm mb-4">@error</div>
            }

            <!-- Booking Summary Box -->
            <div class="p-3 mb-4 rounded-3 border bg-light">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <h5 class="fw-bold text-dark m-0">@Model.Movie.Title</h5>
                        <small class="text-secondary">
                            <i class="bi bi-geo-alt me-1"></i>@Model.CinemaHall.HallName
                        </small>
                    </div>
                    <span class="badge bg-primary px-2 py-1">@seats.Count Seats</span>
                </div>
                <div class="small text-muted mb-2">
                    <i class="bi bi-clock me-1"></i>@Model.StartDateTime.ToString("dd MMM yyyy, h:mm tt")
                </div>
                <div class="small text-muted mb-3">
                    <strong>Seats:</strong> @string.Join(", ", seats)
                </div>
                <div class="border-top pt-2 d-flex justify-content-between align-items-center">
                    <span class="fw-bold text-secondary">Total Amount</span>
                    <span class="fs-5 fw-bold text-primary">RM @total.ToString("0.00")</span>
                </div>
            </div>

            <!-- PayPal Section -->
            <div class="mb-4">
                <h5 class="fw-bold fs-6 text-dark mb-2">
                    <i class="bi bi-paypal text-primary me-1"></i>PayPal Sandbox
                </h5>
                @if (payPalConfigured)
                {
                    <p class="small text-muted mb-3">Log in with a PayPal Sandbox buyer account to approve this simulated payment.</p>
                    <div id="paypal-button-container" class="mb-2"></div>
                    <div id="paypal-error" class="alert alert-danger border-0 shadow-sm d-none mt-3"></div>
                    <div id="paypal-antiforgery">@Html.AntiForgeryToken()</div>
                }
                else
                {
                    <div class="alert alert-warning border-0 small">PayPal Sandbox is not configured. Add a Sandbox Client ID before using this option.</div>
                }
            </div>

            <div class="position-relative my-4 text-center">
                <hr class="text-muted" />
                <span class="position-absolute top-50 start-50 translate-middle bg-white px-3 text-muted small fw-semibold">OR</span>
            </div>

            <!-- Test Card Section -->
            <div>
                <h5 class="fw-bold fs-6 text-dark mb-3">
                    <i class="bi bi-credit-card me-1"></i>Test Card Mock
                </h5>
                <form asp-action="ConfirmPayment" method="post">
                    <input type="hidden" name="showtimeId" value="@Model.Id" />
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-secondary">Cardholder Name</label>
                        <input name="cardHolder" class="form-control form-control-lg" placeholder="John Doe" required />
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-bold small text-secondary">Test Card Number</label>
                        <input name="cardNumber" class="form-control form-control-lg" inputmode="numeric" placeholder="4242 4242 4242 4242" required />
                    </div>
                    <button class="btn btn-outline-primary btn-lg w-100 fw-bold shadow-sm">
                        Complete Test-Card Payment
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @if (payPalConfigured)
    {
        <script src="https://www.paypal.com/sdk/js?client-id=@payPalClientId&currency=MYR&intent=capture"></script>
        <script>
            const payPalError = document.getElementById('paypal-error');
            const antiForgeryToken = document.querySelector('#paypal-antiforgery input').value;
            const showtimeId = '@Model.Id';

            function showPayPalError(message) {
                payPalError.textContent = message;
                payPalError.classList.remove('d-none');
            }

            async function postPayPal(url, payload) {
                const response = await fetch(url, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': antiForgeryToken
                    },
                    body: JSON.stringify(payload)
                });
                const data = await response.json().catch(() => ({}));
                if (!response.ok) throw new Error(data.message || 'The PayPal Sandbox request could not be completed.');
                return data;
            }

            paypal.Buttons({
                createOrder: (_data, actions) => actions.order.create({
                    intent: 'CAPTURE',
                    purchase_units: [{
                        description: 'Cinema ticket reservation',
                        amount: {
                            currency_code: 'MYR',
                            value: '@total.ToString(System.Globalization.CultureInfo.InvariantCulture)'
                        }
                    }]
                }),
                onApprove: async (data, actions) => {
                    await actions.order.capture();
                    const result = await postPayPal('@Url.Action("ConfirmClientPayPalPayment", "Bookings")', {
                        showtimeId,
                        orderId: data.orderID
                    });
                    window.location.assign(result.receiptUrl);
                },
                onCancel: () => showPayPalError('PayPal payment was cancelled. Your seats remain held until the timer expires.'),
                onError: error => showPayPalError(error.message || 'PayPal Sandbox could not process this payment.')
            }).render('#paypal-button-container');
        </script>
    }
}