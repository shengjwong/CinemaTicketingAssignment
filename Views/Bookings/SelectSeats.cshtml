@model CinemaTicketingAssignment.Models.SeatSelectionViewModel
@{
    ViewData["Title"] = "Choose your seats";
    var capacity = Model.Showtime.CinemaHall.SeatCapacity;
    var halfColumns = Model.Columns / 2;
    var rowCount = (int)Math.Ceiling(capacity / (double)Model.Columns);
}

<div class="container my-4">
    <a asp-controller="Showtimes" asp-action="CustomerIndex" asp-route-movieId="@Model.Showtime.MovieId" class="btn btn-outline-secondary btn-sm mb-3">
        <i class="bi bi-arrow-left me-1"></i>Back to Showtimes
    </a>

    <div class="row g-4">
        <!-- Main Seat Map View -->
        <div class="col-lg-8">
            <div class="content-card">
                <div class="mb-4">
                    <h2 class="page-title m-0">Choose Your Seats</h2>
                    <p class="text-muted small mt-1 mb-0">
                        <strong>@Model.Showtime.Movie.Title</strong> ·
                        <i class="bi bi-geo-alt me-1"></i>@Model.Showtime.CinemaHall.HallName ·
                        <i class="bi bi-clock me-1"></i>@Model.Showtime.StartDateTime.ToString("dd MMM, h:mm tt")
                    </p>
                </div>

                <!-- Top-down cinema plan -->
                <div class="cinema-map" aria-label="Top-down cinema seating plan">
                    <div class="screen-zone" aria-hidden="true">
                        <div class="screen-glow"></div>
                        <div class="cinema-screen">SCREEN</div>
                        <span class="screen-caption">FRONT OF HALL</span>
                    </div>

                    <div class="seat-legend" aria-label="Seat status legend">
                        <span><i class="seat-swatch available"></i> Available</span>
                        <span><i class="seat-swatch selected"></i> Your selection</span>
                        <span><i class="seat-swatch occupied"></i> Booked / Locked</span>
                    </div>

                    <div class="cinema-floor-scroll">
                        <div class="cinema-floor">
                            <div class="side-aisle side-aisle-left" aria-hidden="true"></div>
                            <div class="side-aisle side-aisle-right" aria-hidden="true"></div>

                            <div id="seat-grid" class="top-view-seat-grid">
                                @for (var rowIndex = 0; rowIndex < rowCount; rowIndex++)
                                {
                                    var rowLetter = (char)('A' + rowIndex);
                                    <div class="cinema-seat-row" style="--row-depth: @rowIndex">
                                        <span class="row-label">@rowLetter</span>
                                        <div class="row-seats" style="grid-template-columns: repeat(@halfColumns, minmax(36px, 1fr)) 42px repeat(@halfColumns, minmax(36px, 1fr));">
                                            @for (var column = 0; column < halfColumns; column++)
                                            {
                                                var index = rowIndex * Model.Columns + column;
                                                if (index < capacity)
                                                {
                                                    var seat = $"{rowLetter}{column + 1}";
                                                    var isBooked = Model.BookedSeats.Contains(seat);
                                                    var isLocked = Model.LockedSeats.Contains(seat);
                                                    var isMine = Model.MyHeldSeats.Contains(seat);
                                                    var seatState = isBooked || isLocked ? "occupied" : isMine ? "selected" : "available";
                                                    <button type="button"
                                                            class="seat @seatState"
                                                            data-seat="@seat"
                                                            aria-label="Seat @seat, @seatState"
                                                            aria-pressed="@(isMine ? "true" : "false")"
                                                            disabled="@(isBooked || isLocked)">
                                                        <span>@seat</span>
                                                    </button>
                                                }
                                            }

                                            <span class="centre-aisle" aria-hidden="true"><i></i></span>

                                            @for (var column = halfColumns; column < Model.Columns; column++)
                                            {
                                                var index = rowIndex * Model.Columns + column;
                                                if (index < capacity)
                                                {
                                                    var seat = $"{rowLetter}{column + 1}";
                                                    var isBooked = Model.BookedSeats.Contains(seat);
                                                    var isLocked = Model.LockedSeats.Contains(seat);
                                                    var isMine = Model.MyHeldSeats.Contains(seat);
                                                    var seatState = isBooked || isLocked ? "occupied" : isMine ? "selected" : "available";
                                                    <button type="button"
                                                            class="seat @seatState"
                                                            data-seat="@seat"
                                                            aria-label="Seat @seat, @seatState"
                                                            aria-pressed="@(isMine ? "true" : "false")"
                                                            disabled="@(isBooked || isLocked)">
                                                        <span>@seat</span>
                                                    </button>
                                                }
                                            }
                                        </div>
                                        <span class="row-label">@rowLetter</span>
                                    </div>
                                }
                            </div>

                            <div class="hall-rear" aria-hidden="true">
                                <span><i class="bi bi-box-arrow-left"></i> EXIT</span>
                                <span>REAR OF HALL</span>
                                <span>EXIT <i class="bi bi-box-arrow-right"></i></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Order Summary Sidebar -->
        <aside class="col-lg-4">
            <div class="form-card sticky-lg-top" style="top: 1rem;">
                <h4 class="fw-bold text-dark mb-3">Booking Summary</h4>

                <div class="mb-3 small">
                    <div class="d-flex justify-content-between py-1">
                        <span class="text-secondary">Price per seat:</span>
                        <strong class="text-dark">RM @Model.Showtime.TicketPrice.ToString("0.00")</strong>
                    </div>
                    <div class="d-flex justify-content-between py-1">
                        <span class="text-secondary">Selected Seats:</span>
                        <strong id="chosen-seats" class="text-primary text-end">None</strong>
                    </div>
                </div>

                <hr />

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="fw-bold text-secondary">Total Price</span>
                    <span id="total" class="fs-4 fw-bold text-success">RM 0.00</span>
                </div>

                <p id="hold-note" class="small text-muted mb-3">
                    <i class="bi bi-info-circle me-1"></i>Seats are held for 8 minutes while you pay.
                </p>

                <div id="seat-error" class="alert alert-danger border-0 shadow-sm d-none small mb-3"></div>

                <form id="payment-form" asp-action="Payment" method="get">
                    <input type="hidden" name="showtimeId" value="@Model.Showtime.Id" />
                    <button id="pay-button" class="btn btn-success btn-lg w-100 fw-bold shadow-sm" disabled>
                        Continue to Payment
                    </button>
                </form>

                @Html.AntiForgeryToken()
            </div>
        </aside>
    </div>
</div>

@section Scripts {
    <script>
        const selected = new Set(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MyHeldSeats)));
        const price = @Model.Showtime.TicketPrice.ToString(System.Globalization.CultureInfo.InvariantCulture);
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        const showtimeId = '@Model.Showtime.Id';
        const errorBox = document.getElementById('seat-error');

        function render() {
            document.querySelectorAll('.seat:not(.occupied)').forEach(button => {
                const isSelected = selected.has(button.dataset.seat);
                button.classList.toggle('selected', isSelected);
                button.classList.toggle('available', !isSelected);
                button.setAttribute('aria-pressed', isSelected.toString());
            });
            const seats = [...selected].sort();
            document.getElementById('chosen-seats').textContent = seats.length ? seats.join(', ') : 'None';
            document.getElementById('total').textContent = `RM ${(seats.length * price).toFixed(2)}`;
            document.getElementById('pay-button').disabled = seats.length === 0;
        }

        async function updateHolds() {
            const response = await fetch('@Url.Action("UpdateSeatHolds", "Bookings")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({ showtimeId, seats: [...selected] })
            });
            if (!response.ok) {
                const body = await response.json().catch(() => ({ message: 'Could not hold the selected seats.' }));
                errorBox.textContent = body.message;
                errorBox.classList.remove('d-none');
                return false;
            }
            errorBox.classList.add('d-none');
            return true;
        }

        document.querySelectorAll('.seat.available, .seat.selected').forEach(button => button.addEventListener('click', async () => {
            const seat = button.dataset.seat;
            const wasSelected = selected.has(seat);
            wasSelected ? selected.delete(seat) : selected.add(seat);
            render();
            if (!await updateHolds()) {
                wasSelected ? selected.add(seat) : selected.delete(seat);
                render();
            }
        }));

        render();
    </script>
}
