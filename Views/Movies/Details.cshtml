@model CinemaTicketingAssignment.Models.Movie
@{
    ViewData["Title"] = Model.Title;
    var reviews = (List<CinemaTicketingAssignment.Models.Review>)ViewBag.Reviews ?? new List<CinemaTicketingAssignment.Models.Review>();
    double avgRating = reviews.Any() ? reviews.Average(r => r.Rating) : 0;
}

<div class="container my-4">
    <!-- Movie Details Header Card -->
    <div class="content-card mb-4 p-4">
        <div class="row g-4 align-items-center">
            <div class="col-md-4 col-lg-3 text-center">
                <img src="@(Model.PosterImagePath ?? "/images/default-poster.jpg")"
                     class="img-fluid rounded shadow-sm w-100"
                     alt="@Model.Title"
                     style="max-height: 380px; object-fit: cover;" />
            </div>
            <div class="col-md-8 col-lg-9">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                    <span class="badge bg-primary px-3 py-2">@Model.Genre</span>
                    <span class="badge bg-secondary px-3 py-2">@Model.Language</span>
                    <span class="badge bg-warning text-dark px-3 py-2 fw-bold" id="avgRatingBadge">
                        ⭐ @avgRating.ToString("0.0")/5.0
                    </span>
                </div>
                <h1 class="display-6 fw-bold text-dark mb-3">@Model.Title</h1>
                <p class="text-secondary leading-relaxed mb-4" style="font-size: 1.05rem;">
                    @Model.Synopsis
                </p>

                <div class="pt-2">
                    <a asp-controller="Showtimes" asp-action="CustomerIndex" asp-route-movieId="@Model.Id" class="btn btn-primary btn-lg fw-bold shadow-sm px-4" data-i18n="btn-book-tickets">
                        🎟️ Book Tickets
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Reviews Section -->
    <div class="content-card p-4">
        <h3 class="fs-4 fw-bold text-dark mb-4" data-i18n="review-heading">Customer Reviews & Ratings</h3>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success border-0 shadow-sm mb-4">@TempData["Success"]</div>
        }

        <!-- User Review Form -->
        @if (User.Identity != null && User.Identity.IsAuthenticated && !User.IsInRole("ADMIN"))
        {
            <form asp-controller="Reviews" asp-action="AddReview" method="post" class="form-card mb-4 bg-light" id="addReviewForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="movieId" value="@Model.Id" />

                <div class="mb-3">
                    <label class="form-label fw-bold small text-secondary" data-i18n="review-star-label">Select Star Rating</label>
                    <select name="rating" class="form-select form-select-lg" style="max-width: 200px;" required>
                        <option value="5">⭐⭐⭐⭐⭐ (5/5)</option>
                        <option value="4">⭐⭐⭐⭐ (4/5)</option>
                        <option value="3">⭐⭐⭐ (3/5)</option>
                        <option value="2">⭐⭐ (2/5)</option>
                        <option value="1">⭐ (1/5)</option>
                    </select>
                </div>

                <div class="mb-3">
                    <textarea name="comment" class="form-control" rows="3" placeholder="Write your thoughts..." data-i18n-holder="review-placeholder" required></textarea>
                </div>

                <button type="submit" class="btn btn-success fw-bold px-4 shadow-sm" data-i18n="btn-post-review">Post Review</button>
            </form>
        }

        <!-- Reviews List -->
        <div class="d-flex flex-column gap-3" id="reviewsList">
            @if (!reviews.Any())
            {
                <div class="text-center py-4 text-muted" data-i18n="review-empty" id="noReviewsMessage">
                    <i class="bi bi-chat-square-dots display-6 d-block mb-2 opacity-50"></i>
                    No reviews yet. Be the first to review!
                </div>
            }
            else
            {
                @foreach (var rev in reviews)
                {
                    <div class="p-3 bg-light rounded-3 border shadow-sm" id="review-@rev.Id">
                        <div class="d-flex w-100 justify-content-between align-items-center mb-2">
                            <span class="fw-bold text-warning fs-6">⭐ @rev.Rating/5 Stars</span>
                            <small class="text-muted fw-semibold">@rev.CreatedAt.ToString("yyyy-MM-dd HH:mm")</small>
                        </div>
                        <p class="mb-2 text-dark">@rev.Comment</p>

                        @if (User.IsInRole("ADMIN"))
                        {
                            <form asp-controller="Reviews" asp-action="DeleteReview" method="post" class="mt-2 text-end delete-review-form" data-review-id="@rev.Id">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@rev.Id" />
                                <input type="hidden" name="movieId" value="@Model.Id" />
                                <button type="submit" class="btn btn-outline-danger btn-sm fw-semibold" data-i18n="btn-delete-admin">
                                    <i class="bi bi-trash me-1"></i>Delete Review (Admin)
                                </button>
                            </form>
                        }
                    </div>
                }
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function() {
            const addForm = document.getElementById('addReviewForm');
            const reviewsList = document.getElementById('reviewsList');
            const avgBadge = document.getElementById('avgRatingBadge');
            const isAdmin = @Json.Serialize(User.IsInRole("ADMIN"));
            const antiForgeryToken = document.querySelector('#addReviewForm input[name="__RequestVerificationToken"]')?.value;

            function updateAverageBadge(avg) {
                if (avgBadge) avgBadge.textContent = '⭐ ' + Number(avg).toFixed(1) + '/5.0';
            }

            function removeEmptyMessage() {
                const msg = document.getElementById('noReviewsMessage');
                if (msg) msg.remove();
            }

            function showEmptyMessageIfNeeded() {
                if (reviewsList.children.length === 0) {
                    reviewsList.innerHTML = '<div class="text-center py-4 text-muted" id="noReviewsMessage"><i class="bi bi-chat-square-dots display-6 d-block mb-2 opacity-50"></i>No reviews yet. Be the first to review!</div>';
                }
            }

            function buildReviewCard(review) {
                const stars = '⭐'.repeat(review.rating);
                const deleteBtn = review.canDelete
                    ? `<form class="mt-2 text-end delete-review-form" data-review-id="${review.id}">
                                   <button type="button" class="btn btn-outline-danger btn-sm fw-semibold delete-review-btn" data-review-id="${review.id}"><i class="bi bi-trash me-1"></i>Delete Review (Admin)</button>
                               </form>`
                    : '';

                const card = document.createElement('div');
                card.className = 'p-3 bg-light rounded-3 border shadow-sm';
                card.id = 'review-' + review.id;
                card.innerHTML = `
                            <div class="d-flex w-100 justify-content-between align-items-center mb-2">
                                <span class="fw-bold text-warning fs-6">${stars} ${review.rating}/5 Stars</span>
                                <small class="text-muted fw-semibold">${review.createdAt}</small>
                            </div>
                            <p class="mb-2 text-dark"></p>
                            ${deleteBtn}`;
                card.querySelector('p').textContent = review.comment;
                return card;
            }

            if (addForm) {
                addForm.addEventListener('submit', function(e) {
                    e.preventDefault();
                    const formData = new FormData(addForm);
                    const submitBtn = addForm.querySelector('button[type="submit"]');
                    submitBtn.disabled = true;

                    fetch(addForm.action, {
                        method: 'POST',
                        headers: { 'X-Requested-With': 'XMLHttpRequest' },
                        body: formData
                    })
                        .then(async res => {
                            if (!res.ok) {
                                const err = await res.json().catch(() => ({ message: 'Could not post review.' }));
                                throw new Error(err.message);
                            }
                            return res.json();
                        })
                        .then(review => {
                            removeEmptyMessage();
                            reviewsList.insertBefore(buildReviewCard(review), reviewsList.firstChild);
                            updateAverageBadge(review.averageRating);
                            addForm.reset();
                        })
                        .catch(err => alert(err.message || 'Could not post review.'))
                        .finally(() => { submitBtn.disabled = false; });
                });
            }

            function handleDelete(reviewId, form) {
                if (!confirm('Delete this review?')) return;

                const formData = new FormData();
                formData.append('id', reviewId);
                formData.append('movieId', @Json.Serialize(Model.Id));
                if (antiForgeryToken) formData.append('__RequestVerificationToken', antiForgeryToken);

                fetch('/Reviews/DeleteReview', {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    body: formData
                })
                    .then(res => { if (!res.ok) throw new Error('Could not delete review.'); return res.json(); })
                    .then(result => {
                        document.getElementById('review-' + result.id)?.remove();
                        updateAverageBadge(result.averageRating);
                        showEmptyMessageIfNeeded();
                    })
                    .catch(err => alert(err.message));
            }

            // Existing server-rendered delete forms (present on initial page load)
            reviewsList.addEventListener('submit', function(e) {
                const form = e.target.closest('.delete-review-form');
                if (!form) return;
                e.preventDefault();
                handleDelete(form.dataset.reviewId, form);
            });

            // Delete buttons on dynamically-added reviews (built client-side, no <form> submit)
            reviewsList.addEventListener('click', function(e) {
                const btn = e.target.closest('.delete-review-btn');
                if (!btn) return;
                handleDelete(btn.dataset.reviewId, null);
            });
        })();
    </script>
}