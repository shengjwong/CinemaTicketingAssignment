@model CinemaTicketingAssignment.Models.Movie
@{
    ViewData["Title"] = Model.Title;
    var reviews = (List<CinemaTicketingAssignment.Models.Review>)ViewBag.Reviews ?? new List<CinemaTicketingAssignment.Models.Review>();
    double avgRating = reviews.Any() ? reviews.Average(r => r.Rating) : 0;
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-4">
            <img src="@(Model.PosterImagePath ?? "/images/default-poster.jpg")" class="img-fluid rounded shadow" alt="@Model.Title" />
        </div>
        <div class="col-md-8">
            <h2>@Model.Title</h2>
            <p class="text-muted">@Model.Genre | @Model.Language | <span data-i18n="label-rating">Rating:</span> <span class="badge bg-warning text-dark" id="avgRatingBadge">⭐ @avgRating.ToString("0.0")/5.0</span></p>
            <p>@Model.Synopsis</p>

            <!-- 指向普通用户的 Showtimes 选座路由 -->
            <a asp-controller="Showtimes" asp-action="CustomerIndex" asp-route-movieId="@Model.Id" class="btn btn-primary btn-lg mt-3" data-i18n="btn-book-tickets">
                🎟️ Book Tickets
            </a>
        </div>
    </div>

    <hr />

    <!-- 评论与评分展示模块 -->
    <h3 class="mb-3" data-i18n="review-heading">Customer Reviews & Ratings</h3>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <!-- 用户发表评价框 -->
    @if (User.Identity != null && User.Identity.IsAuthenticated && !User.IsInRole("ADMIN"))
    {
        <form asp-controller="Reviews" asp-action="AddReview" method="post" class="card card-body bg-light mb-4 shadow-sm" id="addReviewForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="movieId" value="@Model.Id" />

            <div class="mb-3">
                <label class="form-label fw-bold" data-i18n="review-star-label">Select Star Rating</label>
                <select name="rating" class="form-select" style="width: 160px;" required>
                    <option value="5">⭐⭐⭐⭐⭐ (5/5)</option>
                    <option value="4">⭐⭐⭐⭐ (4/5)</option>
                    <option value="3">⭐⭐⭐ (3/5)</option>
                    <option value="2">⭐⭐ (2/5)</option>
                    <option value="1">⭐ (1/5)</option>
                </select>
            </div>

            <div class="mb-3">
                <textarea name="comment" class="form-control" rows="3" placeholder="Write your thoughts..." data-i18n-holder="review-placeholder" required></textarea>
            </div>

            <button type="submit" class="btn btn-success" style="width: 150px;" data-i18n="btn-post-review">Post Review</button>
        </form>
    }

    <!-- 评论展示列表 -->
    <div class="list-group" id="reviewsList">
        @if (!reviews.Any())
        {
            <p class="text-muted" data-i18n="review-empty" id="noReviewsMessage">No reviews yet. Be the first to review!</p>
        }
        else
        {
            @foreach (var rev in reviews)
            {
                <div class="list-group-item list-group-item-action flex-column align-items-start mb-2 rounded shadow-sm" id="review-@rev.Id">
                    <div class="d-flex w-100 justify-content-between">
                        <h6 class="mb-1 fw-bold">⭐ @rev.Rating/5 Stars</h6>
                        <small class="text-muted">@rev.CreatedAt.ToString("yyyy-MM-dd HH:mm")</small>
                    </div>
                    <p class="mb-1 text-secondary">@rev.Comment</p>

                    @if (User.IsInRole("ADMIN"))
                    {
                        <form asp-controller="Reviews" asp-action="DeleteReview" method="post" class="mt-2 text-end delete-review-form" data-review-id="@rev.Id">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@rev.Id" />
                            <input type="hidden" name="movieId" value="@Model.Id" />
                            <button type="submit" class="btn btn-danger btn-sm" data-i18n="btn-delete-admin">Delete Review (Admin)</button>
                        </form>
                    }
                </div>
            }
        }
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const addForm = document.getElementById('addReviewForm');
            const reviewsList = document.getElementById('reviewsList');
            const avgBadge = document.getElementById('avgRatingBadge');
            const isAdmin = @Json.Serialize(User.IsInRole("ADMIN"));
            const antiForgeryToken = document.querySelector('#addReviewForm input[name="__RequestVerificationToken"]')?.value;

            function updateAverageBadge(avg) {
                if (avgBadge) avgBadge.textContent = '⭐ ' + Number(avg).toFixed(1) + '/5.0';
            }

            function removeEmptyMessage() {
                const msg = document.getElementById('noReviewsMessage');
                if (msg) msg.remove();
            }

            function showEmptyMessageIfNeeded() {
                if (reviewsList.children.length === 0) {
                    reviewsList.innerHTML = '<p class="text-muted" id="noReviewsMessage">No reviews yet. Be the first to review!</p>';
                }
            }

            function buildReviewCard(review) {
                const stars = '⭐'.repeat(review.rating);
                const deleteBtn = review.canDelete
                    ? `<form class="mt-2 text-end delete-review-form" data-review-id="${review.id}">
                           <button type="button" class="btn btn-danger btn-sm delete-review-btn" data-review-id="${review.id}">Delete Review (Admin)</button>
                       </form>`
                    : '';

                const card = document.createElement('div');
                card.className = 'list-group-item list-group-item-action flex-column align-items-start mb-2 rounded shadow-sm';
                card.id = 'review-' + review.id;
                card.innerHTML = `
                    <div class="d-flex w-100 justify-content-between">
                        <h6 class="mb-1 fw-bold">${stars} ${review.rating}/5 Stars</h6>
                        <small class="text-muted">${review.createdAt}</small>
                    </div>
                    <p class="mb-1 text-secondary"></p>
                    ${deleteBtn}`;
                card.querySelector('p').textContent = review.comment;
                return card;
            }

            if (addForm) {
                addForm.addEventListener('submit', function (e) {
                    e.preventDefault();
                    const formData = new FormData(addForm);
                    const submitBtn = addForm.querySelector('button[type="submit"]');
                    submitBtn.disabled = true;

                    fetch(addForm.action, {
                        method: 'POST',
                        headers: { 'X-Requested-With': 'XMLHttpRequest' },
                        body: formData
                    })
                        .then(async res => {
                            if (!res.ok) {
                                const err = await res.json().catch(() => ({ message: 'Could not post review.' }));
                                throw new Error(err.message);
                            }
                            return res.json();
                        })
                        .then(review => {
                            removeEmptyMessage();
                            reviewsList.insertBefore(buildReviewCard(review), reviewsList.firstChild);
                            updateAverageBadge(review.averageRating);
                            addForm.reset();
                        })
                        .catch(err => alert(err.message || 'Could not post review.'))
                        .finally(() => { submitBtn.disabled = false; });
                });
            }

            function handleDelete(reviewId, form) {
                if (!confirm('Delete this review?')) return;

                const formData = new FormData();
                formData.append('id', reviewId);
                formData.append('movieId', @Json.Serialize(Model.Id));
                if (antiForgeryToken) formData.append('__RequestVerificationToken', antiForgeryToken);

                fetch('/Reviews/DeleteReview', {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    body: formData
                })
                    .then(res => { if (!res.ok) throw new Error('Could not delete review.'); return res.json(); })
                    .then(result => {
                        document.getElementById('review-' + result.id)?.remove();
                        updateAverageBadge(result.averageRating);
                        showEmptyMessageIfNeeded();
                    })
                    .catch(err => alert(err.message));
            }

            // Existing server-rendered delete forms (present on initial page load)
            reviewsList.addEventListener('submit', function (e) {
                const form = e.target.closest('.delete-review-form');
                if (!form) return;
                e.preventDefault();
                handleDelete(form.dataset.reviewId, form);
            });

            // Delete buttons on dynamically-added reviews (built client-side, no <form> submit)
            reviewsList.addEventListener('click', function (e) {
                const btn = e.target.closest('.delete-review-btn');
                if (!btn) return;
                handleDelete(btn.dataset.reviewId, null);
            });
        })();
    </script>
}