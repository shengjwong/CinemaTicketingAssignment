@model List<Movie>
@{
    ViewData["Title"] = "Movies";
    var status = (MovieStatus)ViewBag.SelectedStatus;
}

<h1 class="mb-3">Movies</h1>

<ul class="nav nav-tabs mb-4">
    <li class="nav-item">
        <button type="button" class="nav-link movie-status-tab @(status == MovieStatus.NowShowing ? "active" : "")" data-status="NowShowing">Now Showing</button>
    </li>
    <li class="nav-item">
        <button type="button" class="nav-link movie-status-tab @(status == MovieStatus.ComingSoon ? "active" : "")" data-status="ComingSoon">Coming Soon</button>
    </li>
</ul>

<div class="row g-2 mb-4" id="movieFilters">
    <div class="col-md-4">
        <input id="movieSearch" type="search" class="form-control" placeholder="Search movie title, genre or language..." value="@ViewBag.Search" autocomplete="off" />
    </div>
    <div class="col-md-2">
        <select id="movieGenre" class="form-select">
            <option value="">All Genres</option>
            @foreach (var g in (List<string>)ViewBag.Genres)
            {
                <option value="@g" selected="@(g == ViewBag.SelectedGenre)">@g</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <select id="movieLanguage" class="form-select">
            <option value="">All Languages</option>
            @foreach (var l in (List<string>)ViewBag.Languages)
            {
                <option value="@l" selected="@(l == ViewBag.SelectedLanguage)">@l</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <select id="movieAge" class="form-select">
            <option value="">All Ratings</option>
            @foreach (var a in (List<string>)ViewBag.AgeClassifications)
            {
                <option value="@a" selected="@(a == ViewBag.SelectedAge)">@a</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <button type="button" id="clearMovieFilters" class="btn btn-outline-secondary w-100">Clear</button>
    </div>
</div>

<div id="movieResults">
    @await Html.PartialAsync("_MovieCatalogResults", Model)
</div>

@section Scripts {
<script>
(() => {
    let status = '@status';
    let debounceTimer;

    const loadMovies = (page = 1) => {
        const params = new URLSearchParams({
            search: document.getElementById('movieSearch').value,
            genre: document.getElementById('movieGenre').value,
            language: document.getElementById('movieLanguage').value,
            age: document.getElementById('movieAge').value,
            status,
            page
        });

        history.replaceState(null, '', `/Movies?${params.toString()}`);
        fetch(`/Movies/Search?${params.toString()}`, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(r => r.ok ? r.text() : Promise.reject(r.statusText))
            .then(html => document.getElementById('movieResults').innerHTML = html)
            .catch(() => document.getElementById('movieResults').innerHTML = '<div class="alert alert-danger">Unable to load movies. Please refresh the page.</div>');
    };

    document.getElementById('movieSearch').addEventListener('input', () => {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => loadMovies(1), 300);
    });

    ['movieGenre', 'movieLanguage', 'movieAge'].forEach(id => {
        document.getElementById(id).addEventListener('change', () => loadMovies(1));
    });

    document.getElementById('clearMovieFilters').addEventListener('click', () => {
        document.getElementById('movieSearch').value = '';
        document.getElementById('movieGenre').value = '';
        document.getElementById('movieLanguage').value = '';
        document.getElementById('movieAge').value = '';
        loadMovies(1);
    });

    document.querySelectorAll('.movie-status-tab').forEach(button => {
        button.addEventListener('click', () => {
            status = button.dataset.status;
            document.querySelectorAll('.movie-status-tab').forEach(x => x.classList.toggle('active', x === button));
            loadMovies(1);
        });
    });

    document.getElementById('movieResults').addEventListener('click', event => {
        const button = event.target.closest('.movie-page');
        if (button) loadMovies(button.dataset.page);
    });
})();
</script>
}
