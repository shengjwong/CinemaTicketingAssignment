@model List<Movie>
@{
    var page = ViewBag.Page is int p ? p : 1;
    var totalPages = ViewBag.TotalPages is int tp ? tp : 1;
    var totalCount = ViewBag.TotalCount is int tc ? tc : Model.Count;
    var search = ViewBag.Search as string;
    var genre = ViewBag.SelectedGenre as string;
    var language = ViewBag.SelectedLanguage as string;
    var age = ViewBag.SelectedAge as string;
    var status = ViewBag.SelectedStatus is MovieStatus s ? s : MovieStatus.NowShowing;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <span class="text-muted">@totalCount movie(s) found</span>
    <small class="text-muted">Page @(page) of @Math.Max(totalPages, 1)</small>
</div>

@if (!Model.Any())
{
    <div class="alert alert-light border">No movies match your search and filters.</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-4 g-4">
        @foreach (var movie in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrWhiteSpace(movie.PosterImagePath))
                    {
                        <img src="@movie.PosterImagePath" class="card-img-top" alt="@movie.Title poster" style="height:320px;object-fit:cover;" />
                    }
                    else
                    {
                        <div class="d-flex align-items-center justify-content-center bg-light text-muted" style="height:320px;">No Poster</div>
                    }
                    <div class="card-body">
                        <h5 class="card-title">@movie.Title</h5>
                        <h6 class="card-subtitle mb-2 text-muted">@movie.Genre &middot; @movie.Language &middot; @movie.AgeClassification</h6>
                        <p class="card-text">@(movie.Synopsis.Length > 100 ? movie.Synopsis[..100] + "..." : movie.Synopsis)</p>
                        <p class="card-text"><small class="text-muted">Release: @movie.ReleaseDate.ToString("dd MMM yyyy")</small></p>
                    </div>
                    <div class="card-footer">
                        <a asp-action="Details" asp-route-id="@movie.Id" class="btn btn-primary btn-sm">View Showtimes</a>
                    </div>
                </div>
            </div>
        }
    </div>
}

@if (totalPages > 1)
{
    <nav class="mt-4" aria-label="Movie pagination">
        <ul class="pagination justify-content-center">
            @for (var i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == page ? "active" : "")">
                    <button type="button" class="page-link movie-page" data-page="@i">@i</button>
                </li>
            }
        </ul>
    </nav>
}
