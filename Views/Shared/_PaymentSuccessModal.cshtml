@model string

<div class="modal fade" id="paymentSuccessModal" tabindex="-1" aria-labelledby="paymentSuccessTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="paymentSuccessTitle">Payment Successful</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center p-4">
                <div class="display-4 text-success mb-3">✓</div>
                <p class="mb-0">@Model</p>
            </div>
            <div class="modal-footer justify-content-center border-0 pt-0">
                <button type="button" class="btn btn-success px-4" data-bs-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

<script>
    window.addEventListener('load', () => {
        const modalElement = document.getElementById('paymentSuccessModal');
        if (modalElement && window.bootstrap) new bootstrap.Modal(modalElement).show();
    });
</script>
