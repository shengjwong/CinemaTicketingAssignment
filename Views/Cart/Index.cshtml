@{
    ViewData["Title"] = "My Shopping Cart";
}
@inject IConfiguration Configuration
@{
    var payPalClientId = Configuration["PayPal:ClientId"] ?? string.Empty;
    var payPalConfigured = !string.IsNullOrWhiteSpace(payPalClientId) && !payPalClientId.StartsWith("REPLACE_", StringComparison.OrdinalIgnoreCase);
}

<div class="container my-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="page-title m-0">🛒 My Shopping Cart</h2>
    </div>

    @Html.AntiForgeryToken()

    <!-- Cart Main Content -->
    <div id="cartContent">
        <div class="table-card p-0 overflow-hidden">
            <div class="table-responsive">
                <table class="table custom-table mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>Item Description</th>
                            <th class="text-center">Price</th>
                            <th class="text-center" style="width: 120px;">Quantity</th>
                            <th class="text-end">Subtotal</th>
                            <th class="text-center" style="width: 100px;">Action</th>
                        </tr>
                    </thead>
                    <tbody id="cartTableBody">
                        <!-- JS Dynamic Render -->
                    </tbody>
                </table>
            </div>
        </div>

        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center mt-4 gap-3">
            <button class="btn btn-outline-danger fw-semibold align-self-start align-self-sm-center" onclick="clearCart()">
                <i class="bi bi-trash me-1"></i>Clear Cart
            </button>
            <div class="text-end">
                <div class="mb-2">
                    <span class="text-muted small me-2">Total Amount:</span>
                    <span class="fs-4 fw-bold text-success" id="cartTotal">RM 0.00</span>
                </div>
                <button class="btn btn-success btn-lg fw-bold px-4 shadow-sm" onclick="checkout()">
                    <i class="bi bi-credit-card me-1"></i>Proceed to Checkout
                </button>
            </div>
        </div>
    </div>

    <!-- Empty Cart Message -->
    <div id="emptyCartMsg" class="content-card text-center py-5 d-none">
        <i class="bi bi-cart-x text-muted display-4"></i>
        <h4 class="fw-bold mt-3">Your cart is empty!</h4>
        <p class="text-muted">Explore our movies and snacks to add items to your cart.</p>
        <div class="d-flex justify-content-center gap-2 mt-3">
            <a asp-controller="Movies" asp-action="Index" class="btn btn-primary fw-semibold">Browse Movies</a>
            <a asp-controller="Concessions" asp-action="Index" class="btn btn-outline-primary fw-semibold">Browse Snacks</a>
        </div>
    </div>

    <!-- Checkout Panel -->
    <div id="checkoutPanel" class="form-card d-none">
        <div class="border-bottom pb-3 mb-3">
            <h4 class="fw-bold text-dark m-0">Confirm Your Purchase</h4>
            <p class="text-muted small m-0 mt-1">Please review the items below before confirming your purchase.</p>
        </div>

        <div class="table-responsive mb-3">
            <table class="table custom-table mb-0 align-middle">
                <thead>
                    <tr>
                        <th>Item Description</th>
                        <th class="text-center">Quantity</th>
                        <th class="text-end">Subtotal</th>
                    </tr>
                </thead>
                <tbody id="checkoutTableBody"></tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
            <span class="fw-bold text-secondary">Final Total</span>
            <span id="checkoutTotal" class="fs-4 fw-bold text-success">RM 0.00</span>
        </div>

        <div id="foodPayPalError" class="alert alert-danger d-none mt-3"></div>
        <div class="d-flex justify-content-end gap-2 mt-4">
            <button type="button" class="btn btn-outline-secondary fw-semibold" onclick="returnToCart()">Back to Cart</button>
            <button type="button" class="btn btn-success fw-bold px-4" onclick="confirmPurchase()">Confirm Purchase</button>
        </div>
        @if (payPalConfigured)
        {
            <div class="border-top mt-4 pt-3">
                <p class="small text-muted mb-2">Or pay using a PayPal Sandbox buyer account.</p>
                <div id="food-paypal-button-container"></div>
            </div>
        }
    </div>
</div>

<script>
    function renderCart() {
        const cartItems = JSON.parse(localStorage.getItem('snack_cart') || '[]');
        const tbody = document.getElementById('cartTableBody');
        const cartContent = document.getElementById('cartContent');
        const emptyMsg = document.getElementById('emptyCartMsg');

        if (cartItems.length === 0) {
            cartContent.classList.add('d-none');
            emptyMsg.classList.remove('d-none');
            return;
        }

        cartContent.classList.remove('d-none');
        emptyMsg.classList.add('d-none');
        tbody.innerHTML = '';
        let total = 0;

        cartItems.forEach((item, index) => {
            const subtotal = item.price * item.quantity;
            total += subtotal;

            tbody.innerHTML += `
                    <tr>
                        <td class="fw-bold text-dark">${item.name}</td>
                        <td class="text-center">RM ${item.price.toFixed(2)}</td>
                        <td class="text-center"><span class="badge bg-light text-dark border px-2 py-1">${item.quantity}</span></td>
                        <td class="text-end fw-bold text-primary">RM ${subtotal.toFixed(2)}</td>
                        <td class="text-center">
                            <button class="btn btn-outline-danger btn-sm fw-semibold" onclick="removeItem(${index})">Remove</button>
                        </td>
                    </tr>
                `;
        });

        document.getElementById('cartTotal').innerText = 'RM ' + total.toFixed(2);
    }

    function removeItem(index) {
        let cartItems = JSON.parse(localStorage.getItem('snack_cart') || '[]');
        cartItems.splice(index, 1);
        localStorage.setItem('snack_cart', JSON.stringify(cartItems));
        renderCart();
    }

    function clearCart() {
        if (confirm('Are you sure you want to clear your cart?')) {
            localStorage.removeItem('snack_cart');
            renderCart();
        }
    }

    function checkout() {
        const cartItems = JSON.parse(localStorage.getItem('snack_cart') || '[]');
        if (cartItems.length === 0) {
            renderCart();
            return;
        }

        const checkoutBody = document.getElementById('checkoutTableBody');
        let total = 0;
        checkoutBody.innerHTML = '';

        cartItems.forEach(item => {
            const subtotal = item.price * item.quantity;
            total += subtotal;
            checkoutBody.innerHTML += `
                    <tr>
                        <td class="fw-bold text-dark">${item.name}</td>
                        <td class="text-center"><span class="badge bg-light text-dark border px-2 py-1">${item.quantity}</span></td>
                        <td class="text-end fw-bold text-primary">RM ${subtotal.toFixed(2)}</td>
                    </tr>`;
        });

        document.getElementById('checkoutTotal').innerText = 'RM ' + total.toFixed(2);
        document.getElementById('cartContent').classList.add('d-none');
        document.getElementById('emptyCartMsg').classList.add('d-none');
        document.getElementById('checkoutPanel').classList.remove('d-none');
    }

    function returnToCart() {
        document.getElementById('checkoutPanel').classList.add('d-none');
        renderCart();
    }

    function confirmPurchase() {
        const cartItems = JSON.parse(localStorage.getItem('snack_cart') || '[]');
        if (cartItems.length === 0) {
            renderCart();
            return;
        }

        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        fetch('@Url.Action("ConfirmPurchase", "Cart")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            body: JSON.stringify(cartItems.map(item => ({ id: item.id, quantity: item.quantity })))
        })
            .then(async response => {
                if (!response.ok) {
                    const error = await response.json().catch(() => ({ message: 'Unable to confirm this purchase.' }));
                    throw new Error(error.message);
                }
                return response.json();
            })
            .then(result => {
                localStorage.removeItem('snack_cart');
                window.location.href = result.redirectUrl;
            })
            .catch(error => alert(error.message));
    }

    function cartRequestItems() {
        return JSON.parse(localStorage.getItem('snack_cart') || '[]')
            .map(item => ({ id: item.id, quantity: item.quantity }));
    }

    function showFoodPayPalError(message) {
        const box = document.getElementById('foodPayPalError');
        box.textContent = message;
        box.classList.remove('d-none');
    }

    document.addEventListener('DOMContentLoaded', renderCart);
</script>
@if (payPalConfigured)
{
    <script src="https://www.paypal.com/sdk/js?client-id=@payPalClientId&currency=MYR&intent=capture"></script>
    <script>
        paypal.Buttons({
            createOrder: (_data, actions) => {
                const items = JSON.parse(localStorage.getItem('snack_cart') || '[]');
                const total = items.reduce((sum, item) => sum + item.price * item.quantity, 0);
                if (!items.length) return Promise.reject(new Error('Your cart is empty.'));
                return actions.order.create({
                    intent: 'CAPTURE',
                    purchase_units: [{ description: 'Cinema food and beverages', amount: { currency_code: 'MYR', value: total.toFixed(2) } }]
                });
            },
            onApprove: async (data, actions) => {
                try {
                    await actions.order.capture();
                    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                    const response = await fetch('@Url.Action("ConfirmPayPalPurchase", "Cart")', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                        body: JSON.stringify({ items: cartRequestItems(), orderId: data.orderID })
                    });
                    const result = await response.json().catch(() => ({}));
                    if (!response.ok) throw new Error(result.message || 'Unable to record the food order.');
                    localStorage.removeItem('snack_cart');
                    window.location.href = result.redirectUrl;
                } catch (error) {
                    showFoodPayPalError(error.message || 'PayPal Sandbox could not complete this purchase.');
                }
            },
            onCancel: () => showFoodPayPalError('PayPal payment was cancelled. Your cart is unchanged.'),
            onError: error => showFoodPayPalError(error.message || 'PayPal Sandbox could not process this purchase.')
        }).render('#food-paypal-button-container');
    </script>
}
