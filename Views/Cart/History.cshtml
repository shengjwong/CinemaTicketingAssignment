@model List<CinemaTicketingAssignment.Models.FoodOrder>
@{ ViewData["Title"] = "Food Purchase History"; }

<div class="container my-4">
    <h2>🍿 Food Purchase History</h2>
    @if (!Model.Any())
    {
        <div class="alert alert-info">You have not purchased any food items yet.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr><th>Order</th><th>Items</th><th>Total</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td>@order.Id<br /><small>@order.OrderDate.ToLocalTime().ToString("dd MMM yyyy, h:mm tt")</small></td>
                            <td>@string.Join(", ", order.Items.Select(i => $"{i.ItemName} x{i.Quantity}"))</td>
                            <td>RM @order.TotalAmount.ToString("0.00")<br /><small class="text-success">@order.PaymentStatus</small></td>
                            <td><a asp-action="Receipt" asp-route-id="@order.Id" class="btn btn-outline-primary btn-sm">Receipt</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
