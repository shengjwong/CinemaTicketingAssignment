@model CinemaTicketingAssignment.Models.ProfileViewModel

@{
    ViewData["Title"] = "My Profile";
}

<div class="container my-4">
    <!-- Page Header -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="page-title m-0">User Profile Maintenance</h2>
            <p class="text-muted small mb-0 mt-1">Manage your personal information and security settings</p>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["PasswordError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["PasswordError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        @* Personal Details Form Card *@
        <div class="col-lg-6">
            <div class="form-card h-100">
                <div class="d-flex align-items-center gap-2 mb-4 pb-2 border-bottom">
                    <i class="bi bi-person-badge fs-4 text-primary"></i>
                    <h4 class="m-0 fw-bold fs-5">Personal Information</h4>
                </div>

                <form asp-controller="Profile" asp-action="UpdateProfile" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    @* Avatar Preview and Upload (Only Visible to Members) *@
                    @if (User.IsInRole("MEMBER"))
                    {
                        <div class="text-center mb-4">
                            <div class="position-relative d-inline-block">
                                @if (!string.IsNullOrEmpty(Model.PhotoURL))
                                {
                                    <img src="@Model.PhotoURL" alt="Avatar" class="rounded-circle img-thumbnail shadow-sm" style="width: 120px; height: 120px; object-fit: cover;" />
                                }
                                else
                                {
                                    <div class="rounded-circle bg-light border d-flex align-items-center justify-content-center shadow-sm" style="width: 120px; height: 120px;">
                                        <i class="bi bi-person text-secondary display-5"></i>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="AvatarFile" class="form-label fw-bold small text-secondary">Upload Profile Picture</label>
                            <input asp-for="AvatarFile" type="file" class="form-control" accept="image/*" />
                        </div>
                    }

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-bold small text-secondary">Full Name</label>
                        <input asp-for="Name" class="form-control" placeholder="Your full name" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-bold small text-secondary">Email Address</label>
                        <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Phone" class="form-label fw-bold small text-secondary">Phone Number</label>
                        <input asp-for="Phone" class="form-control" placeholder="e.g. +60123456789" />
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold shadow-sm">
                        <i class="bi bi-save me-1"></i>Save Profile
                    </button>
                </form>
            </div>
        </div>

        @* Password Change Form Card *@
        <div class="col-lg-6">
            <div class="form-card h-100">
                <div class="d-flex align-items-center gap-2 mb-4 pb-2 border-bottom">
                    <i class="bi bi-shield-lock fs-4 text-warning"></i>
                    <h4 class="m-0 fw-bold fs-5">Security & Password</h4>
                </div>

                <form asp-controller="Profile" asp-action="ChangePassword" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label fw-bold small text-secondary">Current Password</label>
                        <input asp-for="CurrentPassword" type="password" class="form-control" placeholder="••••••••" required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label fw-bold small text-secondary">New Password</label>
                        <input asp-for="NewPassword" type="password" class="form-control" placeholder="••••••••" required />
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-bold small text-secondary">Confirm New Password</label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="••••••••" required />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-warning btn-lg w-100 fw-bold text-dark shadow-sm">
                        <i class="bi bi-key me-1"></i>Update Password
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}