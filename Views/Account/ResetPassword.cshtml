@model CinemaTicketingAssignment.Models.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
}

<div class="auth-container mt-5">
    <div class="auth-card">
        <div class="text-center mb-4">
            <h2 class="page-title m-0">Reset Password</h2>
            <p class="text-muted small mt-1">Please enter your new password below</p>
        </div>

        <form asp-controller="Account" asp-action="ResetPassword" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

            <!-- Hidden fields to pass token and email back to POST action -->
            <input type="hidden" asp-for="Token" />
            <input type="hidden" asp-for="Email" />

            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label fw-bold small text-secondary">New Password</label>
                <input asp-for="NewPassword" type="password" class="form-control form-control-lg" placeholder="Enter new password" required />
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label fw-bold small text-secondary">Confirm Password</label>
                <input asp-for="ConfirmPassword" type="password" class="form-control form-control-lg" placeholder="Confirm new password" required />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold shadow-sm mb-3">
                Reset Password
            </button>
        </form>

        <hr class="my-4" />

        <div class="text-center small">
            <a asp-controller="Account" asp-action="Login" class="text-decoration-none fw-bold">
                <i class="bi bi-arrow-left me-1"></i>Back to Login
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}