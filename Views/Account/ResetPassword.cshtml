@model CinemaTicketingAssignment.Models.ResetPasswordViewModel

<h2>Reset Password</h2>

<form asp-controller="Account" asp-action="ResetPassword" method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <!-- Hidden fields to pass token and email back to POST action -->
    <input type="hidden" asp-for="Token" />
    <input type="hidden" asp-for="Email" />

    <div>
        <label asp-for="NewPassword">New Password</label>
        <input asp-for="NewPassword" type="password" />
        <span asp-validation-for="NewPassword" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="ConfirmPassword">Confirm Password</label>
        <input asp-for="ConfirmPassword" type="password" />
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    </div>

    <button type="submit">Reset Password</button>
</form>

<p>
    <a asp-controller="Account" asp-action="Login">Back to Login</a>
</p>