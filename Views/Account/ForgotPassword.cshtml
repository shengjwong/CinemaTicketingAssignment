@model CinemaTicketingAssignment.Models.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
}

<div class="auth-container mt-5">
    <div class="auth-card">
        <div class="text-center mb-4">
            <h2 class="page-title m-0">Forgot Password</h2>
            <p class="text-muted small mt-1">Enter your email to receive a password reset link</p>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success border-0 shadow-sm mb-3">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger border-0 shadow-sm mb-3">
                <p class="mb-0"><strong>SMTP Error:</strong> @TempData["ErrorMessage"]</p>
            </div>
        }

        @if (TempData["ResetLink"] != null)
        {
            <div class="alert alert-warning border-0 shadow-sm mb-3 text-break">
                <p class="mb-1"><strong>Fallback Reset Link:</strong></p>
                <a href="@TempData["ResetLink"]" class="alert-link">@TempData["ResetLink"]</a>
            </div>
        }

        <div asp-validation-summary="All" class="text-danger small mb-3"></div>

        <form asp-controller="Account" asp-action="ForgotPassword" method="post">
            <div class="mb-4">
                <label asp-for="Email" class="form-label fw-bold small text-secondary">Account Email Address</label>
                <input asp-for="Email" class="form-control form-control-lg" placeholder="name@example.com" required />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold shadow-sm mb-3">
                Generate Reset Link
            </button>
        </form>

        <hr class="my-4" />

        <div class="text-center small">
            <a asp-controller="Account" asp-action="Login" class="text-decoration-none fw-bold">
                <i class="bi bi-arrow-left me-1"></i>Back to Login
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}