@model CinemaTicketingAssignment.Models.ForgotPasswordViewModel

<h2>Forgot Password</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        <p><strong>SMTP Error:</strong> @TempData["ErrorMessage"]</p>
    </div>
}

@if (TempData["ResetLink"] != null)
{
    <div class="alert alert-warning">
        <p><strong>Fallback Reset Link:</strong></p>
        <a href="@TempData["ResetLink"]">@TempData["ResetLink"]</a>
    </div>
}

<div asp-validation-summary="All" class="text-danger"></div>

<form asp-controller="Account" asp-action="ForgotPassword" method="post">
    <div class="form-group">
        <label asp-for="Email">Enter your account email address:</label>
        <input asp-for="Email" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Generate Reset Link</button>
</form>

<p>
    <a asp-controller="Account" asp-action="Login">Back to Login</a>
</p>