@model CinemaTicketingAssignment.Models.LoginViewModel

<h2>User Login</h2>

<form asp-controller="Account" asp-action="Login" method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly"></div>

    <div>
        <label>Email Address:</label>
        <input asp-for="Email" />
    </div>

    <div>
        <label>Password:</label>
        <input asp-for="Password" type="password" />
    </div>

    <button type="submit">Sign In</button>
</form>

<hr />
<!-- 快捷切换链接 -->
<p>
    Are you an Admin?
    <a asp-controller="Account" asp-action="AdminLogin">Go to Admin Login</a> |
    <a asp-controller="Home" asp-action="Index">Back to Welcome Page</a>
</p>