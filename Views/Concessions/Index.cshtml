@model List<CinemaTicketingAssignment.Models.Concession>
@{
    ViewData["Title"] = "Snacks & Food Menu";
    bool isAdmin = User.IsInRole("ADMIN");
}

<div class="container my-4">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center mb-4 gap-2">
        <h2 class="page-title m-0" data-i18n="snack-title">🍿 Cinema Snacks & Combos</h2>
        @if (isAdmin)
        {
            <a asp-action="Manage" class="btn btn-warning fw-bold shadow-sm">
                <i class="bi bi-gear-fill me-1"></i>Manage Snacks (Admin)
            </a>
        }
    </div>

    <!-- Snacks Grid -->
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="content-card h-100 d-flex flex-column justify-content-between text-center p-4">
                    <div>
                        <div class="display-6 mb-2">🍿</div>
                        <h5 class="fw-bold text-dark mb-2">@item.ItemName</h5>
                        <p class="fs-4 text-primary fw-bold mb-3">RM @item.Price.ToString("0.00")</p>
                    </div>

                    @* 仅限普通用户显示数量选择 *@
                    @if (!isAdmin)
                    {
                        <div class="pt-3 border-top">
                            <div class="d-flex justify-content-center align-items-center gap-2">
                                <label class="fw-bold small text-secondary" data-i18n="label-qty">Qty:</label>
                                <input type="number"
                                       class="form-control form-control-sm text-center qty-input fw-bold"
                                       data-id="@item.Id"
                                       data-name="@item.ItemName"
                                       data-price="@item.Price"
                                       value="0"
                                       min="0"
                                       max="10"
                                       style="width: 80px;"
                                       onchange="updateTotal()" />
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    @* 仅限普通用户显示“加入购物车”栏；Admin 显示提示面板 *@
    @if (!isAdmin)
    {
        <div class="form-card mt-4 p-3 d-flex flex-column flex-sm-row justify-content-between align-items-center shadow-sm gap-3">
            <div>
                <span class="text-muted small me-2" data-i18n="label-total">Selected Snack Total:</span>
                <span class="fs-4 fw-bold text-success" id="grandTotal">RM 0.00</span>
            </div>
            <button class="btn btn-success btn-lg fw-bold px-4 shadow-sm" onclick="addToCart()" data-i18n="btn-add-snack">
                <i class="bi bi-cart-plus me-1"></i>Add to Cart
            </button>
        </div>
    }
    else
    {
        <div class="alert alert-info border-0 shadow-sm mt-4 text-center">
            <i class="bi bi-info-circle-fill me-2"></i>
            <strong>Administrator View:</strong> Booking and Cart options are disabled for Admin users.
        </div>
    }
</div>

@section Scripts {
    <script>
        function updateTotal() {
            let total = 0;
            document.querySelectorAll('.qty-input').forEach(input => {
                const price = parseFloat(input.getAttribute('data-price'));
                const qty = parseInt(input.value) || 0;
                total += price * qty;
            });
            document.getElementById('grandTotal').innerText = 'RM ' + total.toFixed(2);
        }

        function addToCart() {
            // 1. 拦截未登录的用户
            const isAuthenticated = @(User.Identity?.IsAuthenticated == true ? "true" : "false");

            if (!isAuthenticated) {
                alert('Please log in first to add snacks to your cart!');
                window.location.href = '/Account/Login?ReturnUrl=' + encodeURIComponent(window.location.pathname);
                return;
            }

            // 2. 已登录用户正常收集数据
            let selectedItems = [];
            document.querySelectorAll('.qty-input').forEach(input => {
                const qty = parseInt(input.value) || 0;
                if (qty > 0) {
                    selectedItems.push({
                        id: input.getAttribute('data-id'),
                        name: input.getAttribute('data-name'),
                        price: parseFloat(input.getAttribute('data-price')),
                        quantity: qty
                    });
                }
            });

            if (selectedItems.length === 0) {
                alert('Please select at least 1 snack before adding to cart.');
                return;
            }

            // 保存小吃数据至本地购物车缓存
            localStorage.setItem('snack_cart', JSON.stringify(selectedItems));
            alert('🍿 Snacks successfully added to your Cart!');
            window.location.href = '/Cart/Index';
        }
    </script>
}