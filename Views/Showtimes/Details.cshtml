@model Showtime
@{
    ViewData["Title"] = "Showtime Details";
}

<a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-3">&larr; Back to Showtimes</a>

<h1>@Model.Movie.Title</h1>

<dl class="row">
    <dt class="col-sm-2">Hall</dt>
    <dd class="col-sm-10">@Model.CinemaHall.HallName (@Model.CinemaHall.HallType)</dd>
    <dt class="col-sm-2">Date</dt>
    <dd class="col-sm-10">@Model.StartDateTime.ToString("dd MMM yyyy")</dd>
    <dt class="col-sm-2">Start</dt>
    <dd class="col-sm-10">@Model.StartDateTime.ToString("h:mm tt")</dd>
    <dt class="col-sm-2">End</dt>
    <dd class="col-sm-10">@Model.EndDateTime.ToString("h:mm tt")</dd>
    <dt class="col-sm-2">Ticket Price</dt>
    <dd class="col-sm-10">RM @Model.TicketPrice.ToString("0.00")</dd>
</dl>
