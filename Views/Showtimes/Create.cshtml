@model Showtime
@{
    ViewData["Title"] = "Create Showtime";
    var movies = (List<Movie>)ViewBag.Movies ?? new List<Movie>();
    var halls = (List<CinemaHall>)ViewBag.CinemaHalls ?? new List<CinemaHall>();
}

<h1 class="mb-3">Create Showtime</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="MovieId" class="form-label">Movie</label>
        <select asp-for="MovieId" class="form-select">
            <option value="">-- Select Movie --</option>
            @foreach (var m in movies)
            {
                <option value="@m.Id">@m.Title</option>
            }
        </select>
        <span asp-validation-for="MovieId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CinemaHallId" class="form-label">Cinema Hall</label>
        <select asp-for="CinemaHallId" class="form-select">
            <option value="">-- Select Cinema Hall --</option>
            @foreach (var h in halls)
            {
                <option value="@h.Id">@h.HallName (@h.HallType)</option>
            }
        </select>
        <span asp-validation-for="CinemaHallId" class="text-danger"></span>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="StartDateTime" class="form-label">Start Date &amp; Time</label>
            <input asp-for="StartDateTime" type="datetime-local" class="form-control" />
            <span asp-validation-for="StartDateTime" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="EndDateTime" class="form-label">End Date &amp; Time</label>
            <input asp-for="EndDateTime" type="datetime-local" class="form-control" />
            <span asp-validation-for="EndDateTime" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="TicketPrice" class="form-label">Ticket Price (RM)</label>
        <input asp-for="TicketPrice" type="number" step="0.01" min="0" class="form-control" />
        <span asp-validation-for="TicketPrice" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Create Showtime</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}