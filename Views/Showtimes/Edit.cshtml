@model Showtime
@{
    ViewData["Title"] = "Edit Showtime";
    var movies = (List<Movie>)ViewBag.Movies ?? new List<Movie>();
    var halls = (List<CinemaHall>)ViewBag.CinemaHalls ?? new List<CinemaHall>();
}

<h1 class="mb-3">Edit Showtime</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="MovieId" class="form-label">Movie</label>
        <select asp-for="MovieId" class="form-select">
            @foreach (var m in movies)
            {
                <option value="@m.Id" selected="@(m.Id == Model.MovieId)">@m.Title</option>
            }
        </select>
        <span asp-validation-for="MovieId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CinemaHallId" class="form-label">Cinema Hall</label>
        <select asp-for="CinemaHallId" id="CinemaHallId" class="form-select">
            @foreach (var h in halls)
            {
                <option value="@h.Id" selected="@(h.Id == Model.CinemaHallId)">@h.HallName (@h.HallType)</option>
            }
        </select>
        <span asp-validation-for="CinemaHallId" class="text-danger"></span>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="StartDateTime" class="form-label">Start Date &amp; Time</label>
            <input asp-for="StartDateTime" id="StartDateTime" type="datetime-local" class="form-control" value="@Model.StartDateTime.ToString("yyyy-MM-ddTHH:mm")" />
            <span asp-validation-for="StartDateTime" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="EndDateTime" class="form-label">End Date &amp; Time</label>
            <input asp-for="EndDateTime" id="EndDateTime" type="datetime-local" class="form-control" value="@Model.EndDateTime.ToString("yyyy-MM-ddTHH:mm")" />
            <span asp-validation-for="EndDateTime" class="text-danger"></span>
        </div>
    </div>

    <div id="availabilityMessage" class="alert d-none" role="status"></div>

    <div class="mb-3">
        <label asp-for="TicketPrice" class="form-label">Ticket Price (RM)</label>
        <input asp-for="TicketPrice" type="number" step="0.01" min="0" class="form-control" />
        <span asp-validation-for="TicketPrice" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
    (() => {
        const hall = document.getElementById('CinemaHallId');
        const start = document.getElementById('StartDateTime');
        const end = document.getElementById('EndDateTime');
        const box = document.getElementById('availabilityMessage');
        let timer;

        const check = () => {
            if (!hall.value || !start.value || !end.value) {
                box.className = 'alert d-none';
                return;
            }
            const qs = new URLSearchParams({
                hallId: hall.value,
                startDateTime: start.value,
                endDateTime: end.value,
                excludeId: '@Model.Id'
            });
            fetch('/Showtimes/CheckAvailability?' + qs.toString())
                .then(r => r.json())
                .then(data => {
                    box.textContent = data.message;
                    box.className = 'alert ' + (data.available ? 'alert-success' : 'alert-danger');
                })
                .catch(() => {
                    box.textContent = 'Unable to check hall availability.';
                    box.className = 'alert alert-warning';
                });
        };

        [hall, start, end].forEach(x => x.addEventListener('change', () => {
            clearTimeout(timer);
            timer = setTimeout(check, 150);
        }));
    })();
    </script>
}
