@{
    ViewData["Title"] = "Home Page";
}

<div class="row justify-content-center align-items-center min-vh-75 my-5">
    <div class="col-lg-8 col-md-10 text-center">
        <div class="form-card py-5 px-4 px-md-5 shadow-sm">
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <div class="display-5 mb-3">🎬</div>
                <h1 class="page-title mb-3">Welcome Back, @User.Identity.Name!</h1>
                <p class="text-muted fs-5 mb-4">Select a section below to start browsing upcoming movies or scheduled showtimes.</p>
                <div class="d-flex flex-column flex-sm-row justify-content-center gap-3 mt-4">
                    <a asp-controller="Movies" asp-action="Index" class="btn btn-primary btn-lg fw-bold px-4 shadow-sm">
                        <i class="bi bi-film me-2"></i>Browse Movies
                    </a>
                    <a asp-controller="Showtimes" asp-action="CustomerIndex" class="btn btn-outline-secondary btn-lg fw-semibold px-4">
                        <i class="bi bi-calendar-event me-2"></i>View Showtimes
                    </a>
                </div>
            }
            else
            {
                <div class="display-4 mb-3">🍿</div>
                <h1 class="page-title mb-3">Welcome to Cinema Ticketing System</h1>
                <p class="text-muted fs-5 mb-4">Please select your login type to proceed:</p>

                <div class="d-flex flex-column flex-sm-row justify-content-center gap-3 mt-4">
                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary btn-lg fw-bold px-4 shadow-sm">
                        <i class="bi bi-person-circle me-2"></i>User Login
                    </a>
                    <a asp-controller="Account" asp-action="AdminLogin" class="btn btn-primary btn-lg fw-bold px-4 shadow-sm">
                        <i class="bi bi-shield-lock-fill me-2"></i>Admin Login
                    </a>
                </div>
            }
        </div>
    </div>
</div>