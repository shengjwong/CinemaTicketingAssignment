@{
    ViewData["Title"] = "Cinema Locations";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div class="container my-4">
    <div class="mb-4">
        <h2 class="page-title m-0">📍 Our Cinema Branches</h2>
        <p class="text-muted small mt-1">Find our flagship cinema halls and branch locations across Klang Valley.</p>
    </div>

    <div class="content-card p-2 overflow-hidden shadow-sm">
        <div id="map" style="height: 520px; width: 100%;" class="rounded"></div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        const map = L.map('map').setView([3.1390, 101.6869], 11);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(map);

        L.marker([3.1587, 101.7142]).addTo(map)
            .bindPopup('<div class="p-1"><b class="text-primary">Cinema HQ (Suria KLCC)</b><br><small class="text-muted">Hall 1 & IMAX 3D Screen</small></div>')
            .openPopup();

        L.marker([3.1186, 101.6761]).addTo(map)
            .bindPopup('<div class="p-1"><b class="text-primary">Cinema Mid Valley</b><br><small class="text-muted">4DX & Dolby Atmos Motion Seats</small></div>');
    </script>
}