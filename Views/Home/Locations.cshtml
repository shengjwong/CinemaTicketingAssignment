@{
    ViewData["Title"] = "Cinema Locations";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div class="container mt-4">
    <h2 class="mb-3">📍 Our Cinema Branches</h2>
    <p class="text-muted">Find our flagship cinema halls and branch locations across Klang Valley.</p>

    <div id="map" style="height: 480px; width: 100%;" class="rounded shadow border"></div>
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        const map = L.map('map').setView([3.1390, 101.6869], 11);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(map);

        L.marker([3.1587, 101.7142]).addTo(map)
            .bindPopup('<b>Cinema HQ (Suria KLCC)</b><br>Hall 1 & IMAX 3D Screen')
            .openPopup();

        L.marker([3.1186, 101.6761]).addTo(map)
            .bindPopup('<b>Cinema Mid Valley</b><br>4DX & Dolby Atmos Motion Seats');
    </script>
}